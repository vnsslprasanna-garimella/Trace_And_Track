# Trace & Track - .gitignore

# OS files
.DS_Store
Thumbs.db

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
dist/
web-build/
*.orig.*

# Build outputs
build/
android/
ios/

# Environment variables
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/

# Antigravity IDE (local agent data - not for version control)
.agents/

# Logs
*.log
